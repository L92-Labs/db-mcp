# Copy to .env (Docker / Node) or set as Worker vars/secrets.

# Access for every connection unless the connection sets its own "access":
#   read_only  (default)  SELECT / WITH / SHOW / EXPLAIN only — sql_execute is not even registered
#   read_write            + INSERT / UPDATE / DELETE / MERGE (one statement, in a transaction)
#   admin                 + DDL, GRANT, VACUUM, multi-statement scripts
DB_ACCESS=read_only

# Result caps and per-statement timeout
DB_MAX_ROWS=200
DB_MAX_RESULT_BYTES=100000      # JSON size of returned rows; rows past it are dropped (truncated_by: "bytes")
DB_MAX_CELL_CHARS=2000          # longer strings / JSON cells are cut
DB_STATEMENT_TIMEOUT_MS=30000

# Audit log: one JSON line per tool call on stderr (Workers: Workers Logs)
#   off | meta (default: tool, connection, class, rows, sql_sha256) | sql (also the SQL text)
DB_AUDIT_LOG=meta

# Guardrails (any connection): hide columns everywhere (comma-separated globs)
# DB_HIDDEN_COLUMNS=password,*token*,*secret*

# Required for HTTP / Docker / Workers remote MCP
MCP_BEARER_TOKEN=change-me

# Transport for Node: stdio | http
MCP_TRANSPORT=stdio
PORT=8787
# Published-image Compose: exact version or digest (default latest)
# DB_MCP_IMAGE=ghcr.io/l92-labs/db-mcp:0.1.0
# Optional Cloudflare Tunnel with docker-compose.image.yml --profile tunnel
# TUNNEL_TOKEN=
# DB_POOL_MAX=5
# DB_ENV_FILE=/absolute/path/to/.env

# --- Option A: one Postgres and/or one BigQuery (connection names "postgres" / "bigquery") ---
DATABASE_URL=postgres://readonly_user:password@localhost:5432/app
# DATABASE_SSL=require            # require | no-verify | disable
# DATABASE_ACCESS=read_write      # overrides DB_ACCESS for this connection
# DATABASE_SCHEMAS=public,shop     # allowlist; everything else is invisible and refused
# DATABASE_HIDDEN_COLUMNS=users.password_hash

# MYSQL_URL=mysql://readonly_user:password@localhost:3306/app
# MYSQL_SSL=require
# MYSQL_ACCESS=read_only
# MYSQL_SCHEMAS=app
# MYSQL_HIDDEN_COLUMNS=api_token

# BIGQUERY_PROJECT_ID=my-project
# BIGQUERY_LOCATION=US
# BIGQUERY_CREDENTIALS_JSON=base64-or-raw-service-account-key-json
# BIGQUERY_DEFAULT_DATASET=analytics
# BIGQUERY_MAX_BYTES_BILLED=10000000000
# BIGQUERY_ACCESS=read_only
# BIGQUERY_DATASETS=analytics      # dataset allowlist
# BIGQUERY_HIDDEN_COLUMNS=email

# --- Option B: many named connections (replaces Option A) ---
# DB_DEFAULT_CONNECTION=app
# DB_CONNECTIONS_JSON={"app":{"engine":"postgres","url":"postgres://…","access":"read_write","description":"main app DB","schemas":["public"],"hidden_columns":["users.password_hash"]},"legacy":{"engine":"mysql","url":"mysql://…"},"warehouse":{"engine":"bigquery","project_id":"my-project","location":"EU","credentials_json":"…","max_bytes_billed":"10000000000","schemas":["analytics"]}}
